{
  "_comment": "Python 암호 API 지식 베이스. 키는 API 정규 이름(CBOM occurrence.symbol 로 쓴다). import 경로가 이 이름으로 끝나면 같은 API 로 본다. match: ref(참조만 있어도 탐지) / call(호출 인자를 읽음) / prefix(이 이름으로 시작하는 호출). *_arg: pos(위치 인자 번호)·kw(키워드 이름). cipher 가 있으면 '암호-모드' 문자열로 해석한다. role: cipher-alg·cipher-mode 는 Cipher(...) 결합의 재료.",
  "apis": {
    "hashlib.md5": {"match": "ref", "function": "digest", "alg": "md5"},
    "hashlib.sha1": {"match": "ref", "function": "digest", "alg": "sha1"},
    "hashlib.sha224": {"match": "ref", "function": "digest", "alg": "sha224"},
    "hashlib.sha256": {"match": "ref", "function": "digest", "alg": "sha256"},
    "hashlib.sha384": {"match": "ref", "function": "digest", "alg": "sha384"},
    "hashlib.sha512": {"match": "ref", "function": "digest", "alg": "sha512"},
    "hashlib.sha3_256": {"match": "ref", "function": "digest", "alg": "sha3_256"},
    "hashlib.sha3_384": {"match": "ref", "function": "digest", "alg": "sha3_384"},
    "hashlib.sha3_512": {"match": "ref", "function": "digest", "alg": "sha3_512"},
    "hashlib.new": {"match": "call", "function": "digest", "alg_arg": {"pos": 0, "kw": "name"}},

    "hashes.MD5": {"match": "ref", "function": "digest", "alg": "MD5"},
    "hashes.SHA1": {"match": "ref", "function": "digest", "alg": "SHA1"},
    "hashes.SHA224": {"match": "ref", "function": "digest", "alg": "SHA224"},
    "hashes.SHA256": {"match": "ref", "function": "digest", "alg": "SHA256"},
    "hashes.SHA384": {"match": "ref", "function": "digest", "alg": "SHA384"},
    "hashes.SHA512": {"match": "ref", "function": "digest", "alg": "SHA512"},
    "hashes.SHA3_256": {"match": "ref", "function": "digest", "alg": "SHA3_256"},
    "hashes.SHA3_384": {"match": "ref", "function": "digest", "alg": "SHA3_384"},
    "hashes.SHA3_512": {"match": "ref", "function": "digest", "alg": "SHA3_512"},

    "rsa.generate_private_key": {"match": "call", "function": "keygen", "alg": "RSA",
                                 "size_arg": {"pos": 1, "kw": "key_size"}},
    "RSA.generate": {"match": "call", "function": "keygen", "alg": "RSA", "size_arg": {"pos": 0, "kw": "bits"},
                     "require_size": true},
    "dsa.generate_private_key": {"match": "call", "function": "keygen", "alg": "DSA",
                                 "size_arg": {"pos": 0, "kw": "key_size"}},
    "dh.generate_parameters": {"match": "call", "function": "keygen", "alg": "DH",
                               "size_arg": {"pos": 1, "kw": "key_size"}},
    "ec.generate_private_key": {"match": "call", "function": "keygen", "alg": "EC",
                                "curve_arg": {"pos": 0, "kw": "curve"}, "require_curve": true},
    "ec.ECDSA": {"match": "ref", "function": "sign", "alg": "ECDSA"},
    "ec.ECDH": {"match": "ref", "function": "keyderive", "alg": "ECDH"},

    "Ed25519PrivateKey": {"match": "prefix", "function": "keygen", "alg": "Ed25519"},
    "Ed448PrivateKey": {"match": "prefix", "function": "keygen", "alg": "Ed448"},
    "X25519PrivateKey": {"match": "prefix", "function": "keygen", "alg": "X25519"},
    "X448PrivateKey": {"match": "prefix", "function": "keygen", "alg": "X448"},

    "algorithms.AES": {"match": "ref", "function": "encrypt", "cipher": "AES", "role": "cipher-alg"},
    "algorithms.AES128": {"match": "ref", "function": "encrypt", "cipher": "AES128", "role": "cipher-alg"},
    "algorithms.AES256": {"match": "ref", "function": "encrypt", "cipher": "AES256", "role": "cipher-alg"},
    "algorithms.TripleDES": {"match": "ref", "function": "encrypt", "cipher": "3des", "role": "cipher-alg"},
    "algorithms.ARC4": {"match": "ref", "function": "encrypt", "cipher": "ARC4", "role": "cipher-alg"},
    "algorithms.Blowfish": {"match": "ref", "function": "encrypt", "cipher": "Blowfish", "role": "cipher-alg"},
    "algorithms.ChaCha20": {"match": "ref", "function": "encrypt", "cipher": "ChaCha20", "role": "cipher-alg"},

    "modes.ECB": {"match": "ref", "role": "cipher-mode", "mode": "ECB",
                  "standalone": {"alg": "AES", "mode": "ECB", "function": "encrypt"}},
    "modes.CBC": {"match": "ref", "role": "cipher-mode", "mode": "CBC"},
    "modes.GCM": {"match": "ref", "role": "cipher-mode", "mode": "GCM"},
    "modes.CTR": {"match": "ref", "role": "cipher-mode", "mode": "CTR"},
    "modes.CFB": {"match": "ref", "role": "cipher-mode", "mode": "CFB"},
    "modes.CFB8": {"match": "ref", "role": "cipher-mode", "mode": "CFB"},
    "modes.OFB": {"match": "ref", "role": "cipher-mode", "mode": "OFB"},
    "modes.XTS": {"match": "ref", "role": "cipher-mode", "mode": "XTS"},
    "Cipher": {"match": "call", "role": "cipher", "alg_arg": {"pos": 0, "kw": "algorithm"},
               "mode_arg": {"pos": 1, "kw": "mode"}},

    "AESGCM": {"match": "ref", "function": "encrypt", "alg": "AES", "mode": "GCM"},
    "AESCCM": {"match": "ref", "function": "encrypt", "alg": "AES", "mode": "CCM"},
    "ChaCha20Poly1305": {"match": "ref", "function": "encrypt", "alg": "ChaCha20-Poly1305"},

    "DES3.new": {"match": "call", "function": "encrypt", "cipher": "3des",
                 "mode_arg": {"pos": 1, "kw": "mode", "strip_prefix": "MODE_"}},
    "DES.new": {"match": "call", "function": "encrypt", "cipher": "DES",
                "mode_arg": {"pos": 1, "kw": "mode", "strip_prefix": "MODE_"}},
    "AES.new": {"match": "call", "function": "encrypt", "cipher": "AES",
                "mode_arg": {"pos": 1, "kw": "mode", "strip_prefix": "MODE_"}},
    "ARC4.new": {"match": "call", "function": "encrypt", "cipher": "ARC4"},
    "Blowfish.new": {"match": "call", "function": "encrypt", "cipher": "Blowfish",
                     "mode_arg": {"pos": 1, "kw": "mode", "strip_prefix": "MODE_"}}
  }
}
